# Copy to .env; generate unique credentials with: openssl rand -hex 24
COMPOSE_PROJECT_NAME=logsentinel
POSTGRES_DB=logsentinel
POSTGRES_USER=logsentinel
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Application credentials are composed from these variables inside containers.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
MLFLOW_PORT=5000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ADMIN_API_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LOG_LEVEL=INFO
RAW_STREAM=logs:raw:v1
NORMALIZED_STREAM=logs:normalized:v1
PREDICTION_STREAM=logs:predictions:v1
DEAD_LETTER_STREAM=logs:failed:v1
STREAM_MAX_LENGTH=100000
CONSUMER_MAX_RETRIES=5
CONSUMER_CLAIM_IDLE_MS=60000
MODEL_NAME=logsentinel-model
MODEL_ALIAS=champion
RANDOM_SEED=42
ALERT_GROUP_WINDOW_SECONDS=300
LOG_RETENTION_DAYS=30
# Journal collection is opt-in and runs as the host user.
JOURNAL_ENABLED=false
COLLECTOR_FILES=

# Phase 2 processor and collector
INGEST_TOKEN=
PROCESSOR_PORT=8012
PROCESSOR_URL=http://127.0.0.1:8012/api/v1/ingest
PROCESSOR_SINK=redis
PROCESSOR_SQLITE_PATH=.local/normalized.sqlite3
PROCESSOR_RATE_PER_MINUTE=6000
REDIS_HOST=redis
REDIS_PORT=6379
DEDUP_TTL_SECONDS=604800
TEMPLATE_MODE=drain3
LOG_TIMEZONE=UTC
COLLECTOR_CONFIG=docs/collector.example.json
COLLECTOR_STATE=.local/collector.sqlite3

# Phase 3 on-demand training and shared causal features
TRAINING_OUTPUT=ml/artifacts
FEATURE_WINDOW_SECONDS=60

# Phase 4 optional MLflow lifecycle (export explicitly for host CLI commands)
MLFLOW_TRACKING_URI=sqlite:///.local/mlflow/tracking.db
MLFLOW_EXPERIMENT_NAME=LogSentinel
# Set for a direct SQLite client experiment; leave unset for HTTP artifact proxying.
MLFLOW_ARTIFACT_ROOT=
MLFLOW_ALLOW_REMOTE=false
MLFLOW_HTTP_REQUEST_TIMEOUT=10
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
MLFLOW_DISABLE_AGENT_HINT=1
MLFLOW_ENABLE_TELEMETRY=false
REGISTRY_AUDIT_PATH=.local/mlflow/lifecycle.sqlite3

# Phase 5 inference: alias resolves once at startup/reload; explicit version takes precedence.
MODEL_VERSION=
INFERENCE_PORT=8013
INFERENCE_API_TOKEN=
INFERENCE_SCOPE=production
# Optional finite score threshold; permitted only with INFERENCE_SCOPE=development.
INFERENCE_THRESHOLD=
INFERENCE_MAX_BATCH=256
INFERENCE_MAX_BODY_BYTES=1048576
INFERENCE_MAX_CONTEXTS=32
INFERENCE_CONTEXT_TTL_SECONDS=900
INFERENCE_RATE_PER_MINUTE=6000

# Phase 6 durable pipeline. Production workers use PostgreSQL; SQLite is explicit local development.
PIPELINE_DB_BACKEND=postgres
PIPELINE_SQLITE_PATH=.local/pipeline.sqlite3
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PIPELINE_OUTBOX_MAX_PENDING=10000
INFERENCE_CONSUMER_GROUP=inference-v1
ALERT_CONSUMER_GROUP=alerts-v1
CONSUMER_LEASE_MS=30000
CONSUMER_RETRY_SECONDS=1
CONSUMER_MAX_RETRY_SECONDS=30
ALERT_PORT=8014
ALERT_API_TOKEN=
ALERT_REQUIRE_WARM_CONTEXT=true
ALERT_MIN_SCORE=
ALERT_HIGH_MARGIN=0.15
ALERT_CRITICAL_MARGIN=0.30

# Phase 7 frontend-facing gateway (localhost only by default).
GATEWAY_API_TOKEN=
GATEWAY_PORT=8000
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROCESSOR_URL=http://127.0.0.1:8012
INFERENCE_URL=http://127.0.0.1:8013
ALERT_MANAGER_URL=http://127.0.0.1:8014
ARCHIVE_CONSUMER_GROUP=archive-v1
TRAINING_JOB_ROOT=.local/training-jobs
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_RATE_PER_MINUTE=600
GATEWAY_TIMEOUT_SECONDS=10
